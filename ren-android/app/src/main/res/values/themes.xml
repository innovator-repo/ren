<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ren" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Ren.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/akane</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Ren</item>
    </style>
</resources>
